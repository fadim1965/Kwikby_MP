<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>kwikby_MP</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cached locally: the machine has no route to nuget.org, so versions are pinned to
         what exists in ~/.nuget/packages. See docs/ECOMMERCE_PLAN.md. -->
    <!-- SQLite is the development store and the source of the one-time import into SQL Server. -->
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="15.0.0" />
    <!-- EF Design package removed to keep the web assembly's EF Core version aligned with the
         test project's in-memory provider (cached locally). Re-add for `dotnet ef migrations`. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <!-- SQL Server is the deployed provider (database "MVStores"). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.9" />
    <!-- Admin exports to .xlsx. Everything in its dependency closure is cached locally too
         (ClosedXML.Parser, DocumentFormat.OpenXml, ExcelNumberFormat, RBush.Signed, SixLabors.Fonts). -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.10" />
  </ItemGroup>

  <!-- Translation catalogues live in App_Data so a language can be edited without a rebuild. They are
       copied next to the binary because Translator reads them from the content root. -->
  <ItemGroup>
    <Content Include="App_Data\i18n\**\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The test project lives in Tests/. The Web SDK globs **/*.cs (and content) from the project
       directory, so without these removals it would try to compile the test sources into the web
       app — including anything under Tests/obj, which is not covered by the default bin/obj
       excludes because those are root-relative only. -->
