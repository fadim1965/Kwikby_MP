    <Compile Remove="readme\**" />
    <Compile Remove="Tests/**" />
    <Compile Remove="Tests\**" />
    <Compile Remove="Kwikby_MP.Api/**" />
    <Compile Remove="Kwikby_MP.Api\**" />
    <Compile Remove="Kwikby_MP.Shared/**" />
    <Compile Remove="Kwikby_MP.Shared\**" />
