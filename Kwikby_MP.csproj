    <Content Remove="Tests/**" />
    <Content Remove="Tests\**" />
    <Content Remove="Kwikby_MP.Api/**" />
    <Content Remove="Kwikby_MP.Api\**" />
    <Content Remove="Kwikby_MP.Shared/**" />
    <Content Remove="Kwikby_MP.Shared\**" />
    <EmbeddedResource Remove="readme\**" />
