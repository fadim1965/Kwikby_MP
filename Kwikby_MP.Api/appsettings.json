{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MultiVendorsStoresConn": ""
    // Local development: put the real SQL Server connection string in
    // appsettings.Local.json (gitignored) or set the environment variable
    // ConnectionStrings__MultiVendorsStoresConn.
  },
  "Api": {
    "Enabled": true,
    "CommandTimeoutSeconds": 30,
    "SlowCommandMs": 1000,
    "Jwt": {
      "Issuer": "kwikby_MP",
      "Audience": "kwikby_MP.Api",
      "SigningKey": "",
      "AccessTokenMinutes": 60
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "RateLimit": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  }
}
