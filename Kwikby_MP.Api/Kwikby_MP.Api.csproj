<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>kwikby_MP.Api</RootNamespace>
    <UserSecretsId>kwikby-mp-api</UserSecretsId>
    <!-- Every version below is pinned to a package that exists in the local NuGet cache;
         nuget.org is not reachable from this machine. See docs/API_IMPLEMENTATION_PLAN.md. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <!-- 5.1.6 matches the version EF Core SqlServer 9.0.9 already resolves in the MVC app. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.6" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.9" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kwikby_MP.csproj" />
  </ItemGroup>
</Project>

