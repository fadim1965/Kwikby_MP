diff --git a/wwwroot/css/kwikby.css b/wwwroot/css/kwikby.css
new file mode 100644
index 0000000..d8a44c1
--- /dev/null
+++ b/wwwroot/css/kwikby.css
@@ -0,0 +1,2068 @@
+/* ==========================================================================
+   kwikby.css: design system for the Kwikby multi-vendor marketplace.
+
+   Palette is taken from the logo: blue #315D9E, green #3BAF29.
+   Structure follows a marketplace listing layout: a search-first header,
+   a category row, a product grid of cards, filter sidebar, shop pages, footer.
+
+   Razor views use the kw-* class names below. Change the tokens in :root to
+   re-theme the whole site; no component hard-codes a colour.
+   ========================================================================== */
+
+/* ---------- 1. Design tokens ----------------------------------------------- */
+:root {
+    /* Brand (from the logo) */
+    --kw-blue: #315d9e;
+    --kw-blue-dark: #24477a;
+    --kw-blue-darker: #1a3360;
+    --kw-blue-light: #4f7fc0;
+    --kw-blue-tint: #e8effa;
+
+    --kw-green: #3baf29;
+    --kw-green-dark: #2f8f20;
+    --kw-green-light: #6cc95a;
+    --kw-green-tint: #e9f7e4;
+
+    /* Neutrals */
+    --kw-ink: #1f2a37;
+    --kw-ink-muted: #4b5563;
+    --kw-ink-subtle: #6b7280;
+    --kw-surface: #ffffff;
+    --kw-surface-muted: #f6f7f9;
+    --kw-surface-raised: #eef1f5;
+    --kw-border: #e3e7ee;
+    --kw-border-strong: #cfd6e0;
+
+    /* Status */
+    --kw-star: #f5a623;
+    --kw-danger: #d64545;
+    --kw-danger-tint: #fdecec;
+    --kw-warning: #b7791f;
+    --kw-warning-tint: #fdf6e3;
+
+    /* Shape and depth */
+    --kw-radius-sm: 6px;
+    --kw-radius: 10px;
+    --kw-radius-lg: 16px;
+    --kw-shadow-sm: 0 1px 2px rgba(15, 23, 42, .06);
+    --kw-shadow: 0 2px 8px rgba(15, 23, 42, .08);
+    --kw-shadow-lg: 0 10px 30px rgba(15, 23, 42, .14);
+
+    /* Type */
+    --kw-font: "Inter", "Segoe UI", Roboto, system-ui, -apple-system, Arial, sans-serif;
+    --kw-font-size: 15px;
+    --kw-line: 1.5;
+
+    /* Layout */
+    --kw-container: 1280px;
+    --kw-header-h: 72px;
+    --kw-focus: 0 0 0 3px rgba(49, 93, 158, .35);
+    --kw-transition: .18s ease;
+}
+
+/* ---------- 2. Base ------------------------------------------------------- */
+*,
+*::before,
+*::after {
+    box-sizing: border-box;
+}
+
+html {
+    -webkit-text-size-adjust: 100%;
+    scroll-padding-top: calc(var(--kw-header-h) + 12px);
+}
+
+body {
+    margin: 0;
+    font-family: var(--kw-font);
+    font-size: var(--kw-font-size);
+    line-height: var(--kw-line);
+    color: var(--kw-ink);
+    background: var(--kw-surface-muted);
+}
+
+img {
+    max-width: 100%;
+    height: auto;
+    display: block;
+}
+
+a {
+    color: var(--kw-blue);
+    text-decoration: none;
+}
+
+a:hover {
+    color: var(--kw-blue-dark);
+    text-decoration: underline;
+}
+
+:focus-visible {
+    outline: none;
+    box-shadow: var(--kw-focus);
+    border-radius: var(--kw-radius-sm);
+}
+
+h1, h2, h3, h4 {
+    margin: 0 0 .5rem;
+    line-height: 1.25;
+    font-weight: 700;
+    color: var(--kw-ink);
+}
+
+h1 { font-size: 1.75rem; }
+h2 { font-size: 1.3rem; }
+h3 { font-size: 1.05rem; }
+
+p {
+    margin: 0 0 1rem;
+}
+
+.kw-muted {
+    color: var(--kw-ink-subtle);
+}
+
+.kw-small {
+    font-size: .85rem;
+}
+
+.kw-visually-hidden {
+    position: absolute !important;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+}
+
+.kw-container {
+    width: 100%;
+    max-width: var(--kw-container);
+    margin-inline: auto;
+    padding-inline: 16px;
+}
+
+/* ---------- 3. Buttons ---------------------------------------------------- */
+.kw-btn {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: .45rem;
+    min-height: 42px;
+    padding: .55rem 1.1rem;
+    border: 1px solid transparent;
+    border-radius: 999px;
+    font: inherit;
+    font-weight: 600;
+    line-height: 1.1;
+    cursor: pointer;
+    text-decoration: none;
+    transition: background var(--kw-transition), color var(--kw-transition),
+                border-color var(--kw-transition), box-shadow var(--kw-transition);
+}
+
+.kw-btn:hover {
