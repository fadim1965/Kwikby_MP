+    border-top: 1px solid rgba(255, 255, 255, .14);
+    font-size: .85rem;
+    color: rgba(255, 255, 255, .7);
+}
+
+.kw-footer .kw-btn--outline {
+    background: transparent;
+    border-color: rgba(255, 255, 255, .4);
+    color: #fff;
+}
+
+.kw-footer .kw-btn--outline:hover {
+    border-color: #fff;
+    color: #fff;
+}
+
+/* ---------- 13. Empty states, toasts, misc -------------------------------- */
+.kw-empty {
+    text-align: center;
+    padding: 56px 16px;
+    background: var(--kw-surface);
+    border: 1px dashed var(--kw-border-strong);
+    border-radius: var(--kw-radius-lg);
+}
+
+.kw-empty h2 {
+    font-size: 1.2rem;
+}
+
+.kw-toast {
+    position: fixed;
+    left: 50%;
+    bottom: 24px;
+    transform: translateX(-50%) translateY(20px);
+    background: var(--kw-ink);
+    color: #fff;
+    padding: 12px 18px;
+    border-radius: var(--kw-radius);
+    box-shadow: var(--kw-shadow-lg);
+    opacity: 0;
+    pointer-events: none;
+    transition: opacity var(--kw-transition), transform var(--kw-transition);
+    z-index: 200;
+}
+
+.kw-toast.is-visible {
+    opacity: 1;
+    transform: translateX(-50%) translateY(0);
+}
+
+.kw-skip {
+    position: absolute;
+    left: 12px;
+    top: -60px;
+    z-index: 300;
+    background: var(--kw-blue);
+    color: #fff;
+    padding: 8px 14px;
+    border-radius: var(--kw-radius-sm);
+}
+
+.kw-skip:focus {
+    top: 12px;
+}
+
+/* ---------- 14. Responsive ------------------------------------------------ */
+@media (min-width: 768px) {
+    .kw-header__link {
+        display: inline-flex;
+    }
+    .kw-hero {
+        padding: 52px 48px;
+    }
+    .kw-product {
+        padding: 32px;
+    }
+}
+
+@media (max-width: 1023px) {
+    .kw-browse {
+        grid-template-columns: minmax(0, 1fr);
+    }
+    .kw-filters {
+        position: static;
+        display: none;
+    }
+    .kw-filters.is-open {
+        display: block;
+    }
+    .kw-filters-toggle {
+        display: inline-flex;
+    }
+    .kw-product {
+        grid-template-columns: minmax(0, 1fr);
+    }
+    .kw-footer__grid {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+}
+
+@media (max-width: 767px) {
+    :root {
+        --kw-header-h: 116px;
+    }
+    .kw-header__bar {
+        flex-wrap: wrap;
+        height: auto;
+        padding: 10px 0;
+        row-gap: 8px;
+    }
+    .kw-logo img {
+        height: 36px;
+    }
+    .kw-search {
+        order: 3;
+        flex: 1 0 100%;
+        max-width: none;
+    }
+    .kw-hero {
+        padding: 28px 22px;
+    }
+    .kw-grid {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+        gap: 14px 10px;
+    }
+    .kw-card__title {
+        font-size: .88rem;
+    }
+    .kw-shop__banner {
+        height: 110px;
+    }
+    .kw-gallery__thumbs {
+        grid-template-columns: repeat(4, 1fr);
+    }
+}
+
+@media (max-width: 479px) {
+    .kw-footer__grid {
+        grid-template-columns: minmax(0, 1fr);
+    }
+}
+
+/* ---------- 15. Reduced motion and high contrast -------------------------- */
+@media (prefers-reduced-motion: reduce) {
+    *,
+    *::before,
+    *::after {
+        transition-duration: 0.01ms !important;
+        animation-duration: 0.01ms !important;
+        scroll-behavior: auto !important;
+    }
+    .kw-card:hover,
+    .kw-tile a:hover {
+        transform: none;
+    }
+}
+
+@media (prefers-contrast: more) {
+    :root {
+        --kw-border: #8a94a6;
+        --kw-border-strong: #4b5563;
+        --kw-ink-subtle: #4b5563;
+    }
+}
+
+/* ==========================================================================
+   16. Navigation menus: Categories (hamburger) and mega menu
+   ========================================================================== */
+
+/* Header nav becomes a positioning context for the mega panels */
+.kw-nav {
+    position: relative;
+}
+
+.kw-nav__inner {
+    display: flex;
+    align-items: stretch;
+    gap: 6px;
+}
+
+/* Trigger buttons (Categories, and the mega menu items) */
+.kw-menu {
+    position: relative;
+    flex: 0 0 auto;
+}
+
+.kw-menu__trigger {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    height: 100%;
+    min-height: 46px;
+    padding: 0 14px;
+    border: 0;
+    border-bottom: 3px solid transparent;
+    background: transparent;
+    font: inherit;
+    font-weight: 600;
+    color: var(--kw-ink);
+    cursor: pointer;
+    white-space: nowrap;
+    border-radius: 0;
+    transition: color var(--kw-transition), border-color var(--kw-transition);
+}
+
+.kw-menu__trigger:hover {
+    color: var(--kw-blue);
+}
+
+.kw-menu__trigger[aria-expanded="true"] {
+    color: var(--kw-blue);
+    border-bottom-color: var(--kw-blue);
+}
+
+.kw-menu__trigger svg {
+    width: 18px;
+    height: 18px;
+    flex: 0 0 auto;
+}
+
+.kw-menu__chevron {
+    width: 12px !important;
+    height: 12px !important;
+    transition: transform var(--kw-transition);
+}
+
+.kw-menu__trigger[aria-expanded="true"] .kw-menu__chevron {
+    transform: rotate(180deg);
+}
+
+/* Categories panel: a list anchored under the hamburger button, with a pointer */
+.kw-categories {
+    position: absolute;
+    top: calc(100% + 14px);
+    left: -4px;
+    z-index: 160;
+    width: 320px;
+    max-height: min(70vh, 520px);
+    overflow-y: auto;
+    background: var(--kw-surface);
+    border-radius: var(--kw-radius);
+    box-shadow: var(--kw-shadow-lg);
+    border: 1px solid var(--kw-border);
+    padding: 8px 0;
+}
+
+.kw-categories[hidden] {
+    display: none;
+}
+
+.kw-categories::before {
+    content: "";
+    position: absolute;
+    top: -8px;
+    left: 26px;
+    width: 14px;
+    height: 14px;
+    background: var(--kw-surface);
+    border-left: 1px solid var(--kw-border);
+    border-top: 1px solid var(--kw-border);
+    transform: rotate(45deg);
+}
+
+.kw-categories__list {
+    list-style: none;
+    margin: 0;
+    padding: 0;
+}
+
+.kw-categories__link {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 12px;
+    padding: 12px 20px;
+    color: var(--kw-ink);
+    font-size: 1rem;
+}
+
+.kw-categories__link:hover,
+.kw-categories__link:focus-visible {
+    background: var(--kw-blue-tint);
+    color: var(--kw-ink);
+    text-decoration: none;
+}
+
+.kw-categories__link svg {
+    width: 14px;
+    height: 14px;
+    color: var(--kw-ink-subtle);
+    flex: 0 0 auto;
+}
+
+.kw-categories__all {
+    display: block;
+    margin: 6px 12px 4px;
+    padding: 10px 12px;
+    border-top: 1px solid var(--kw-border);
+    font-weight: 600;
+    color: var(--kw-blue);
+    text-align: left;
+}
+
+/* Mega panels: full-width under the nav bar */
+.kw-mega {
+    position: absolute;
+    top: 100%;
+    left: 0;
+    right: 0;
+    z-index: 150;
+    background: var(--kw-surface);
+    border-top: 1px solid var(--kw-border);
+    border-bottom: 1px solid var(--kw-border);
+    box-shadow: var(--kw-shadow-lg);
+}
+
+.kw-mega[hidden] {
+    display: none;
+}
+
+.kw-mega__inner {
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(260px, 1.15fr);
+    gap: 32px;
+    padding-block: 28px 32px;
+}
+
+.kw-mega h3 {
+    font-size: .8rem;
+    text-transform: uppercase;
+    letter-spacing: .06em;
+    color: var(--kw-ink-subtle);
+    margin-bottom: 12px;
+}
+
+.kw-mega ul {
+    list-style: none;
+    margin: 0;
+    padding: 0;
+}
+
+.kw-mega li + li {
+    margin-top: 2px;
+}
+
+.kw-mega__link {
+    display: block;
+    padding: 7px 0;
+    color: var(--kw-ink);
+    font-size: .96rem;
+}
+
+.kw-mega__link:hover {
+    color: var(--kw-blue);
+    text-decoration: underline;
+}
+
+.kw-mega__link--strong {
+    font-weight: 600;
+}
+
+/* Promo card on the right of each mega panel */
+.kw-promo {
+    display: flex;
+    flex-direction: column;
+    justify-content: flex-end;
+    min-height: 220px;
+    padding: 22px;
+    border-radius: var(--kw-radius);
+    color: #fff;
+    background: linear-gradient(135deg, var(--kw-blue-dark), var(--kw-blue) 55%, var(--kw-green));
+}
+
+.kw-promo--green {
+    background: linear-gradient(135deg, var(--kw-green-dark), var(--kw-green));
+}
+
+.kw-promo__eyebrow {
+    font-size: .75rem;
+    font-weight: 700;
+    letter-spacing: .08em;
+    text-transform: uppercase;
+    opacity: .9;
+}
+
+.kw-promo h4 {
+    color: #fff;
+    font-size: 1.35rem;
+    margin: 6px 0 14px;
+    max-width: 18ch;
+}
+
+.kw-promo .kw-btn--outline {
+    align-self: flex-start;
+    background: rgba(255, 255, 255, .12);
+    border-color: rgba(255, 255, 255, .6);
+    color: #fff;
+}
+
+.kw-promo .kw-btn--outline:hover {
+    background: #fff;
+    color: var(--kw-blue-dark);
+    border-color: #fff;
+}
+
+/* Keep the bar readable when it wraps to a second row on narrow screens */
+@media (max-width: 1023px) {
+    .kw-mega__inner {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+        gap: 20px;
+        padding-block: 20px 24px;
+    }
+    .kw-promo {
+        grid-column: 1 / -1;
+        min-height: 160px;
+    }
+}
+
+@media (max-width: 767px) {
+    .kw-nav__inner {
+        gap: 0;
+    }
+    .kw-categories {
+        position: fixed;
+        top: var(--kw-header-h);
+        left: 0;
+        right: 0;
+        width: auto;
+        max-height: calc(100vh - var(--kw-header-h));
+        border-radius: 0;
+        border-left: 0;
+        border-right: 0;
+    }
+    .kw-categories::before {
+        display: none;
+    }
+    .kw-mega {
+        position: fixed;
+        top: var(--kw-header-h);
+        bottom: 0;
+        overflow-y: auto;
+        border-radius: 0;
+    }
+    .kw-mega__inner {
+        grid-template-columns: minmax(0, 1fr);
+        gap: 12px;
+        padding-block: 16px 24px;
+    }
+    .kw-menu__trigger {
+        padding: 0 10px;
+        font-size: .92rem;
+    }
+    .kw-menu__trigger span.kw-hide-sm {
+        display: none;
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .kw-menu__chevron {
+        transition: none;
+    }
+}
+
+/* ==========================================================================
+   17. Home page sections
+   ========================================================================== */
+
+.kw-home {
+    padding-bottom: 8px;
+}
+
+.kw-home .kw-section {
+    margin: 36px 0;
+}
+
+/* Deal countdown */
+.kw-countdown {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    font-size: .8rem;
+    font-weight: 700;
+    color: var(--kw-danger);
+    font-variant-numeric: tabular-nums;
+}
+
+.kw-countdown::before {
+    content: "";
+    width: 8px;
+    height: 8px;
+    border-radius: 50%;
+    background: var(--kw-danger);
+}
+
+/* Seasonal banner tiles */
+.kw-seasons {
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    gap: 16px;
+    margin: 0;
+    padding: 0;
+    list-style: none;
+}
+
+.kw-season a {
+    display: flex;
+    flex-direction: column;
+    justify-content: flex-end;
+    min-height: 200px;
+    padding: 20px;
+    border-radius: var(--kw-radius-lg);
+    color: #fff;
+    background: linear-gradient(135deg, var(--kw-blue-dark), var(--kw-blue));
+    box-shadow: var(--kw-shadow-sm);
+    transition: transform var(--kw-transition), box-shadow var(--kw-transition);
+}
+
+.kw-season a:hover {
+    transform: translateY(-2px);
+    box-shadow: var(--kw-shadow);
+    color: #fff;
+    text-decoration: none;
+}
+
+.kw-season--green a {
+    background: linear-gradient(135deg, var(--kw-green-dark), var(--kw-green));
+}
+
+.kw-season--ink a {
+    background: linear-gradient(135deg, #3d4a5c, var(--kw-ink));
+}
+
+.kw-season__eyebrow {
+    font-size: .75rem;
+    font-weight: 700;
+    letter-spacing: .08em;
+    text-transform: uppercase;
+    opacity: .9;
+}
+
+.kw-season h3 {
+    color: #fff;
+    font-size: 1.25rem;
+    margin: 4px 0 0;
+}
+
+/* Top shop cards */
+.kw-shops {
+    display: grid;
+    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
+    gap: 16px;
+    margin: 0;
+    padding: 0;
+    list-style: none;
+}
+
+.kw-shopcard {
+    background: var(--kw-surface);
+    border: 1px solid var(--kw-border);
+    border-radius: var(--kw-radius);
+    overflow: hidden;
+    box-shadow: var(--kw-shadow-sm);
+    height: 100%;
+}
+
+.kw-shopcard__banner {
+    height: 72px;
+    background: linear-gradient(120deg, var(--kw-blue-light), var(--kw-blue));
+}
+
+.kw-shopcard__body {
+    padding: 0 16px 16px;
+    margin-top: -22px;
+}
+
+.kw-shopcard__avatar {
+    width: 44px;
+    height: 44px;
+    border-radius: 50%;
+    border: 3px solid var(--kw-surface);
+    background: var(--kw-green);
+    color: #fff;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    font-weight: 700;
+    margin-bottom: 8px;
+}
+
+.kw-shopcard__name {
+    font-weight: 700;
+    color: var(--kw-ink);
+}
+
+.kw-shopcard__meta {
+    font-size: .82rem;
+    color: var(--kw-ink-subtle);
+    margin-top: 2px;
+}
+
+.kw-shopcard:hover {
+    box-shadow: var(--kw-shadow);
+}
+
+/* Gift guide tiles reuse .kw-tiles; trust strip reuses .kw-trust below */
+.kw-trust {
+    display: grid;
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+    gap: 16px;
+    margin: 0;
+    padding: 20px;
+    list-style: none;
+    background: var(--kw-surface);
+    border: 1px solid var(--kw-border);
+    border-radius: var(--kw-radius-lg);
+}
+
+.kw-trust li {
+    display: flex;
+    gap: 12px;
+    align-items: flex-start;
+}
+
+.kw-trust__icon {
+    flex: 0 0 auto;
+    width: 36px;
+    height: 36px;
+    border-radius: 50%;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    background: var(--kw-green-tint);
+    color: var(--kw-green-dark);
+    font-weight: 700;
+}
+
+.kw-trust strong {
+    display: block;
+    font-size: .95rem;
+}
+
+.kw-trust span.kw-muted {
+    font-size: .85rem;
+}
+
+/* "See more" for the lower sections on phones */
+.kw-more-toggle {
+    display: none;
+    margin: 16px auto 0;
+}
+
+@media (max-width: 1023px) {
+    .kw-trust {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+    .kw-seasons {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+}
+
+@media (max-width: 767px) {
+    .kw-home .kw-section--more {
+        display: none;
+    }
+    .kw-home.is-expanded .kw-section--more {
+        display: block;
+    }
+    .kw-more-toggle {
+        display: inline-flex;
+    }
+    .kw-seasons {
+        grid-template-columns: minmax(0, 1fr);
+    }
+    .kw-trust {
+        grid-template-columns: minmax(0, 1fr);
+    }
+}
+
+/* ==========================================================================
+   18. Navigation panels on phones: anchor below the nav bar, not at a fixed
+       offset from the top (the header height varies with the wrapped rows).
+   ========================================================================== */
+@media (max-width: 767px) {
+    .kw-menu {
+        position: static;
+    }
+    .kw-categories {
+        position: absolute;
+        top: 100%;
+        left: 0;
+        right: 0;
+        width: auto;
+        max-height: 70vh;
+        border-radius: 0 0 var(--kw-radius) var(--kw-radius);
+        border-left: 0;
+        border-right: 0;
+        box-shadow: var(--kw-shadow-lg);
+    }
+    .kw-mega {
+        position: absolute;
+        top: 100%;
+        bottom: auto;
+        max-height: 75vh;
+        overflow-y: auto;
+        border-radius: 0;
+    }
+}
+
+/* ==========================================================================
+   19. "Picked for you": toolbar with category and sort dropdowns, quick chips
+   ========================================================================== */
+.kw-pick-toolbar {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: 12px;
+    margin-bottom: 14px;
+}
+
+.kw-pick-toolbar__selects {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 10px;
+    margin-left: auto;
+}
+
+.kw-pick-toolbar .kw-select {
+    min-width: 170px;
+}
+
+.kw-chips {
+    display: flex;
+    flex-wrap: nowrap;
+    gap: 8px;
+    margin: 0 0 16px;
+    padding: 0;
+    list-style: none;
+    overflow-x: auto;
+    scrollbar-width: none;
+}
+
+.kw-chips::-webkit-scrollbar {
+    display: none;
+}
+
+.kw-chip {
+    display: inline-flex;
+    align-items: center;
+    flex: 0 0 auto;
+    padding: 7px 14px;
+    border: 1px solid var(--kw-border-strong);
+    border-radius: 999px;
+    background: var(--kw-surface);
+    color: var(--kw-ink);
+    font-size: .9rem;
+    font-weight: 600;
+    white-space: nowrap;
+}
+
+.kw-chip:hover {
+    border-color: var(--kw-blue);
+    color: var(--kw-blue);
+    text-decoration: none;
+}
+
+.kw-chip[aria-current="true"] {
+    background: var(--kw-blue-tint);
+    border-color: var(--kw-blue);
+    color: var(--kw-blue-dark);
+}
+
+@media (max-width: 767px) {
+    .kw-pick-toolbar__selects {
+        width: 100%;
+        margin-left: 0;
+    }
+    .kw-pick-toolbar .kw-select {
+        flex: 1 1 140px;
+        min-width: 0;
+    }
+}
+
+/* ==========================================================================
+   20. Hero carousel: four slots (platform, campaign, shop spotlight, category spotlight)
+   ========================================================================== */
+.kw-carousel {
+    position: relative;
+    margin: 20px 0 8px;
+    height: clamp(300px, 36vw, 380px);
+    border-radius: var(--kw-radius-lg);
+    overflow: hidden;
+    background: var(--kw-blue-dark);
+    color: #fff;
+    box-shadow: var(--kw-shadow);
+}
+
+.kw-slide {
+    position: absolute;
+    inset: 0;
+    display: flex;
+    flex-direction: column;
+    justify-content: flex-end;
+    padding: 0 56px 72px;
+    background: linear-gradient(120deg, var(--kw-blue-dark) 0%, var(--kw-blue) 55%, var(--kw-green) 100%);
+    opacity: 0;
+    visibility: hidden;
+    transition: opacity .6s ease, visibility .6s ease;
+}
+
+.kw-slide--campaign { background: linear-gradient(120deg, #1a3360, #315d9e 50%, #6cc95a); }
+.kw-slide--shop     { background: linear-gradient(120deg, #24447a, #4f7fc0 60%, #3baf29); }
+.kw-slide--category { background: linear-gradient(120deg, #2f8f20, #3baf29 55%, #1a3360); }
+
+.kw-slide.is-active {
+    opacity: 1;
+    visibility: visible;
+}
+
+.kw-slide__label {
+    display: inline-flex;
+    align-self: flex-start;
+    padding: 4px 10px;
+    margin-bottom: 12px;
+    border-radius: 999px;
+    background: rgba(255, 255, 255, .18);
+    font-size: .72rem;
+    font-weight: 700;
+    letter-spacing: .08em;
+    text-transform: uppercase;
+}
+
+.kw-slide h1,
+.kw-slide h2 {
+    color: #fff;
+    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
+    max-width: 20ch;
+    margin: 0 0 10px;
+}
+
+.kw-slide p {
+    max-width: 50ch;
+    color: rgba(255, 255, 255, .92);
+    margin: 0 0 18px;
+}
+
+.kw-slide__shop {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    margin-bottom: 18px;
+}
+
+.kw-slide__avatar {
+    width: 52px;
+    height: 52px;
+    border-radius: 50%;
+    background: #fff;
+    color: var(--kw-blue-dark);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    font-weight: 700;
+    font-size: 1.2rem;
+    flex: 0 0 auto;
+}
+
+.kw-carousel .kw-btn--primary {
+    align-self: flex-start;
+}
+
+.kw-carousel .kw-btn--outline {
+    background: rgba(255, 255, 255, .14);
+    border-color: rgba(255, 255, 255, .6);
+    color: #fff;
+}
+
+.kw-carousel .kw-btn--outline:hover {
+    background: #fff;
+    color: var(--kw-blue-dark);
+    border-color: #fff;
+}
+
+/* Controls: bottom row with dots on the left and pause/arrows on the right */
+.kw-carousel__controls {
+    position: absolute;
+    left: 56px;
+    right: 56px;
+    bottom: 22px;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 12px;
+    z-index: 2;
+}
+
+.kw-dots {
+    display: flex;
+    gap: 8px;
+    margin: 0;
+    padding: 0;
+    list-style: none;
+}
+
+.kw-dot {
+    width: 28px;
+    height: 6px;
+    padding: 0;
+    border: 0;
+    border-radius: 999px;
+    background: rgba(255, 255, 255, .45);
+    cursor: pointer;
+    transition: background var(--kw-transition), width var(--kw-transition);
+}
+
+.kw-dot[aria-current="true"] {
+    background: #fff;
+    width: 44px;
+}
+
+.kw-carousel__buttons {
+    display: flex;
+    gap: 8px;
+}
+
+.kw-carousel__btn {
+    width: 40px;
+    height: 40px;
+    border-radius: 50%;
+    border: 1px solid rgba(255, 255, 255, .6);
+    background: rgba(255, 255, 255, .12);
+    color: #fff;
+    cursor: pointer;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+}
+
+.kw-carousel__btn:hover {
+    background: #fff;
+    color: var(--kw-blue-dark);
+}
+
+.kw-carousel__btn svg {
+    width: 18px;
+    height: 18px;
+}
+
+.kw-carousel__pause[aria-pressed="true"] svg .kw-pause-bars {
+    display: none;
+}
+
+.kw-carousel__pause svg .kw-play-tri {
+    display: none;
+}
+
+.kw-carousel__pause[aria-pressed="true"] svg .kw-play-tri {
+    display: inline;
+}
+
+/* Phones: the banner is shorter, and the side arrows give way to swipe-free dots and pause */
+@media (max-width: 767px) {
+    .kw-carousel {
+        height: 320px;
+    }
+    .kw-slide {
+        padding: 0 22px 70px;
+        justify-content: flex-end;
+    }
+    .kw-slide h1,
+    .kw-slide h2 {
+        font-size: 1.55rem;
+    }
+    .kw-carousel__controls {
+        left: 22px;
+        right: 22px;
+        bottom: 18px;
+    }
+    .kw-carousel__btn--arrow {
+        display: none;
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .kw-slide,
+    .kw-dot {
+        transition: none;
+    }
+}
diff --git a/wwwroot/js/kwikby.js b/wwwroot/js/kwikby.js
new file mode 100644
index 0000000..e5bd9af
--- /dev/null
+++ b/wwwroot/js/kwikby.js
@@ -0,0 +1,631 @@
+/* ==========================================================================
+   kwikby.js: progressive enhancement for the Kwikby storefront.
+
+   The site works without JavaScript (forms submit, links navigate). This file
+   adds: search suggestions, favourite toggles, the product gallery, quantity
+   steppers, the mobile filter drawer, and a small toast for feedback.
+
+   Hooks are data attributes, so Razor markup stays free of inline script:
+     [data-kw-suggest]          search input; suggestions load from data-url
+     [data-kw-fav]              favourite button; data-url (optional) saves it
+     [data-kw-thumb]            gallery thumbnail; data-src is the full image
+     [data-kw-qty]              quantity wrapper with [data-kw-dec] and [data-kw-inc]
+     [data-kw-toggle="id"]      opens/closes the element with that id
+     [data-kw-autosubmit]       a <select> that submits its form on change
+     [data-kw-menu-trigger]     button whose aria-controls names a menu panel (Categories, mega menu)
+     [data-kw-countdown]        element with data-kw-countdown="ISO end time"; shows the time left
+     [data-kw-more]             button whose aria-controls names the home page; toggles the lower sections on phones
+     [data-kw-carousel]         hero banner; slides carry data-kw-slide, dots data-kw-dot, and controls data-kw-prev/next/pause
+   ========================================================================== */
+(function () {
+    "use strict";
+
+    var SUGGEST_DELAY_MS = 220;
+    var MIN_QUERY_LENGTH = 2;
+
+    /* ---------- helpers ------------------------------------------------- */
+
+    function $(selector, root) {
+        return (root || document).querySelector(selector);
+    }
+
+    function $$(selector, root) {
+        return Array.prototype.slice.call((root || document).querySelectorAll(selector));
+    }
+
+    function getAntiforgeryToken() {
+        var field = document.querySelector('input[name="__RequestVerificationToken"]');
+        return field ? field.value : "";
+    }
+
+    /** Shows a short message at the bottom of the screen. */
+    function toast(message) {
+        var el = $("#kw-toast");
+        if (!el) {
+            el = document.createElement("div");
+            el.id = "kw-toast";
+            el.className = "kw-toast";
+            el.setAttribute("role", "status");
+            el.setAttribute("aria-live", "polite");
+            document.body.appendChild(el);
+        }
+        el.textContent = message;
+        el.classList.add("is-visible");
+        clearTimeout(el._hideTimer);
+        el._hideTimer = setTimeout(function () {
+            el.classList.remove("is-visible");
+        }, 2400);
+    }
+
+    /** Sends a JSON POST with the anti-forgery token. Resolves to the parsed response or null. */
+    function postJson(url, body) {
+        return fetch(url, {
+            method: "POST",
+            credentials: "same-origin",
+            headers: {
+                "Content-Type": "application/json",
+                "RequestVerificationToken": getAntiforgeryToken()
+            },
+            body: JSON.stringify(body || {})
+        }).then(function (res) {
+            if (!res.ok) {
+                throw new Error("HTTP " + res.status);
+            }
+            return res.headers.get("content-type") && res.headers.get("content-type").indexOf("json") > -1
+                ? res.json()
+                : null;
+        });
+    }
+
+    /* ---------- search suggestions -------------------------------------- */
+
+    /**
+     * Expects the suggest endpoint to return a JSON array of
+     * { type: "Product" | "Shop" | "Category", name: string, url: string }.
+     * Check this against the existing /Catalog/Suggest response and adjust if needed.
+     */
+    function initSuggest(input) {
+        var list = document.getElementById(input.getAttribute("aria-controls") || "");
+        var endpoint = input.getAttribute("data-url");
+        if (!list || !endpoint) {
+            return;
+        }
+
+        var timer = null;
+        var controller = null;
+        var activeIndex = -1;
+
+        function close() {
+            list.classList.remove("is-open");
+            input.setAttribute("aria-expanded", "false");
+            activeIndex = -1;
+        }
+
+        function items() {
+            return $$("li[role='option']", list);
+        }
+
+        function setActive(index) {
+            var all = items();
+            all.forEach(function (li) {
+                li.classList.remove("is-active");
+                li.setAttribute("aria-selected", "false");
+            });
+            if (index < 0 || index >= all.length) {
+                activeIndex = -1;
+                return;
+            }
+            activeIndex = index;
+            all[index].classList.add("is-active");
+            all[index].setAttribute("aria-selected", "true");
+        }
+
+        /** Builds one suggestion row using text nodes only, so names cannot inject markup. */
+        function render(results) {
+            list.textContent = "";
+            if (!results || results.length === 0) {
+                close();
+                return;
+            }
+            results.slice(0, 8).forEach(function (r) {
+                var li = document.createElement("li");
+                li.className = "kw-suggest__item";
+                li.setAttribute("role", "option");
+                li.setAttribute("aria-selected", "false");
+
+                var a = document.createElement("a");
+                a.href = r.url || "#";
+
+                var type = document.createElement("span");
+                type.className = "kw-suggest__type";
+                type.textContent = r.type || "";
+
+                var name = document.createElement("span");
+                name.textContent = r.name || "";
+
+                a.appendChild(type);
+                a.appendChild(name);
+                li.appendChild(a);
+                list.appendChild(li);
+            });
+            list.classList.add("is-open");
+            input.setAttribute("aria-expanded", "true");
+        }
+
+        function fetchSuggestions(query) {
+            if (controller) {
+                controller.abort();
+            }
+            controller = typeof AbortController !== "undefined" ? new AbortController() : null;
+            var url = endpoint + (endpoint.indexOf("?") > -1 ? "&" : "?") + "q=" + encodeURIComponent(query);
+            fetch(url, {
+                credentials: "same-origin",
+                headers: { "Accept": "application/json" },
+                signal: controller ? controller.signal : undefined
+            })
+                .then(function (res) { return res.ok ? res.json() : []; })
+                .then(render)
+                .catch(function (err) {
+                    if (err && err.name !== "AbortError") {
+                        close();
+                    }
+                });
+        }
+
+        input.addEventListener("input", function () {
+            var query = input.value.trim();
+            clearTimeout(timer);
+            if (query.length < MIN_QUERY_LENGTH) {
+                close();
+                return;
+            }
+            timer = setTimeout(function () { fetchSuggestions(query); }, SUGGEST_DELAY_MS);
+        });
+
+        input.addEventListener("keydown", function (e) {
+            if (!list.classList.contains("is-open")) {
+                return;
+            }
+            if (e.key === "ArrowDown") {
+                e.preventDefault();
+                setActive(Math.min(activeIndex + 1, items().length - 1));
+            } else if (e.key === "ArrowUp") {
+                e.preventDefault();
+                setActive(Math.max(activeIndex - 1, 0));
+            } else if (e.key === "Enter" && activeIndex > -1) {
+                e.preventDefault();
+                var link = $("a", items()[activeIndex]);
+                if (link) {
+                    window.location.href = link.href;
+                }
+            } else if (e.key === "Escape") {
+                close();
+            }
+        });
+
+        document.addEventListener("click", function (e) {
+            if (!input.contains(e.target) && !list.contains(e.target)) {
+                close();
+            }
+        });
+    }
+
+    /* ---------- favourites ---------------------------------------------- */
+
+    function initFavourites(button) {
+        button.addEventListener("click", function (e) {
+            e.preventDefault();
+            e.stopPropagation();
+
+            var pressed = button.getAttribute("aria-pressed") === "true";
+            var next = !pressed;
+            button.setAttribute("aria-pressed", String(next));
+            button.setAttribute("aria-label", next ? "Remove from favourites" : "Add to favourites");
+
+            var url = button.getAttribute("data-url");
+            if (!url) {
+                toast(next ? "Saved to favourites" : "Removed from favourites");
+                return;
+            }
+
+            postJson(url, { favourite: next })
+                .then(function () {
+                    toast(next ? "Saved to favourites" : "Removed from favourites");
+                })
+                .catch(function () {
+                    // Roll back the visual state if the server did not accept the change.
+                    button.setAttribute("aria-pressed", String(pressed));
+                    button.setAttribute("aria-label", pressed ? "Remove from favourites" : "Add to favourites");
+                    toast("Could not update favourites. Please sign in and try again.");
+                });
+        });
+    }
+
+    /* ---------- product gallery ----------------------------------------- */
+
+    function initGallery(thumb) {
+        thumb.addEventListener("click", function () {
+            var main = document.querySelector("[data-kw-main]");
+            var src = thumb.getAttribute("data-src");
+            var alt = thumb.getAttribute("data-alt") || "";
+            if (!main || !src) {
+                return;
+            }
+            var img = main.querySelector("img");
+            if (img) {
+                img.src = src;
+                img.alt = alt;
+            }
+            $$("[data-kw-thumb]").forEach(function (t) {
+                t.setAttribute("aria-pressed", t === thumb ? "true" : "false");
+            });
+        });
+    }
+
+    /* ---------- quantity stepper ---------------------------------------- */
+
+    function initQuantity(wrapper) {
+        var input = $("input", wrapper);
+        var dec = $("[data-kw-dec]", wrapper);
+        var inc = $("[data-kw-inc]", wrapper);
+        if (!input) {
+            return;
+        }
+
+        var min = parseInt(input.getAttribute("min") || "1", 10);
+        var max = parseInt(input.getAttribute("max") || "99", 10);
+
+        function clamp(value) {
+            if (isNaN(value)) {
+                return min;
+            }
+            return Math.max(min, Math.min(max, value));
+        }
+
+        function set(value) {
+            input.value = String(clamp(value));
+            input.dispatchEvent(new Event("change", { bubbles: true }));
+        }
+
+        if (dec) {
+            dec.addEventListener("click", function () { set(parseInt(input.value, 10) - 1); });
+        }
+        if (inc) {
+            inc.addEventListener("click", function () { set(parseInt(input.value, 10) + 1); });
+        }
+        input.addEventListener("change", function () { set(parseInt(input.value, 10)); });
+    }
+
+    /* ---------- mobile filter drawer and generic toggles ---------------- */
+
+    function initToggle(button) {
+        var targetId = button.getAttribute("data-kw-toggle");
+        var target = document.getElementById(targetId);
+        if (!target) {
+            return;
+        }
+        button.setAttribute("aria-controls", targetId);
+        button.setAttribute("aria-expanded", "false");
+
+        button.addEventListener("click", function () {
+            var open = !target.classList.contains("is-open");
+            target.classList.toggle("is-open", open);
+            button.setAttribute("aria-expanded", String(open));
+        });
+    }
+
+    /* ---------- sort and filter forms ----------------------------------- */
+
+    function initAutoSubmit(select) {
+        select.addEventListener("change", function () {
+            if (select.form) {
+                select.form.submit();
+            }
+        });
+    }
+
+    /* ---------- navigation menus (Categories and mega menu) ------------- */
+
+    /**
+     * Each trigger has aria-controls pointing at its panel. Click toggles it.
+     * On mouse devices, hovering the trigger or panel also opens it, and leaving
+     * both closes it after a short delay. Only one menu is open at a time.
+     */
+    var CLOSE_DELAY_MS = 180;
+
+    function initMenus() {
+        var triggers = $$("[data-kw-menu-trigger]");
+        if (!triggers.length) {
+            return;
+        }
+
+        var hoverCapable = window.matchMedia && window.matchMedia("(hover: hover) and (pointer: fine)").matches;
+
+        function panelOf(trigger) {
+            return document.getElementById(trigger.getAttribute("aria-controls") || "");
+        }
+
+        function isOpen(trigger) {
+            return trigger.getAttribute("aria-expanded") === "true";
+        }
+
+        function open(trigger) {
+            triggers.forEach(function (t) {
+                if (t !== trigger) {
+                    close(t, false);
+                }
+            });
+            var panel = panelOf(trigger);
+            if (!panel) {
+                return;
+            }
+            clearTimeout(trigger._closeTimer);
+            panel.hidden = false;
+            trigger.setAttribute("aria-expanded", "true");
+        }
+
+        function close(trigger, restoreFocus) {
+            var panel = panelOf(trigger);
+            clearTimeout(trigger._closeTimer);
+            if (panel) {
+                panel.hidden = true;
+            }
+            trigger.setAttribute("aria-expanded", "false");
+            if (restoreFocus) {
+                trigger.focus();
+            }
+        }
+
+        function scheduleClose(trigger) {
+            clearTimeout(trigger._closeTimer);
+            trigger._closeTimer = setTimeout(function () {
+                if (!panelOf(trigger) || !isOpen(trigger)) {
+                    return;
+                }
+                close(trigger, false);
+            }, CLOSE_DELAY_MS);
+        }
+
+        triggers.forEach(function (trigger) {
+            var panel = panelOf(trigger);
+            if (!panel) {
+                return;
+            }
+            panel.hidden = true;
+            trigger.setAttribute("aria-expanded", "false");
+
+            trigger.addEventListener("click", function (e) {
+                e.preventDefault();
+                // A hover that already opened this menu should not be undone by the click that follows it.
+                if (trigger._hoverOpened && isOpen(trigger)) {
+                    trigger._hoverOpened = false;
+                    return;
+                }
+                if (isOpen(trigger)) {
+                    close(trigger, false);
+                } else {
+                    open(trigger);
+                }
+            });
+
+            if (hoverCapable) {
+                trigger.addEventListener("mouseenter", function () {
+                    if (!isOpen(trigger)) {
+                        open(trigger);
+                        trigger._hoverOpened = true;
+                    }
+                });
+                trigger.addEventListener("mouseleave", function () { trigger._hoverOpened = false; scheduleClose(trigger); });
+                panel.addEventListener("mouseenter", function () { clearTimeout(trigger._closeTimer); });
+                panel.addEventListener("mouseleave", function () { scheduleClose(trigger); });
+            }
+
+            trigger.addEventListener("keydown", function (e) {
+                if (e.key === "ArrowDown" && isOpen(trigger)) {
+                    var first = $("a", panel);
+                    if (first) {
+                        e.preventDefault();
+                        first.focus();
+                    }
+                }
+            });
+
+            panel.addEventListener("keydown", function (e) {
+                if (e.key === "Escape") {
+                    close(trigger, true);
+                }
+            });
+        });
+
+        document.addEventListener("click", function (e) {
+            triggers.forEach(function (trigger) {
+                var panel = panelOf(trigger);
+                if (isOpen(trigger) && panel && !panel.contains(e.target) && !trigger.contains(e.target)) {
+                    close(trigger, false);
+                }
+            });
+        });
+
+        document.addEventListener("keydown", function (e) {
+            if (e.key !== "Escape") {
+                return;
+            }
+            triggers.forEach(function (trigger) {
+                if (isOpen(trigger)) {
+                    close(trigger, true);
+                }
+            });
+        });
+    }
+
+    /* ---------- deal countdowns and "See more" on home ------------------- */
+
+    function formatRemaining(ms) {
+        if (ms <= 0) {
+            return "Deal ended";
+        }
+        var total = Math.floor(ms / 1000);
+        var days = Math.floor(total / 86400);
+        var hours = Math.floor((total % 86400) / 3600);
+        var mins = Math.floor((total % 3600) / 60);
+        var secs = total % 60;
+        var pad = function (n) { return (n < 10 ? "0" : "") + n; };
+        var clock = pad(hours) + ":" + pad(mins) + ":" + pad(secs);
+        return days > 0 ? "Ends in " + days + "d " + clock : "Ends in " + clock;
+    }
+
+    function initCountdown(el) {
+        var end = Date.parse(el.getAttribute("data-kw-countdown"));
+        if (isNaN(end)) {
+            return;
+        }
+        function tick() {
+            var remaining = end - Date.now();
+            el.textContent = formatRemaining(remaining);
+            if (remaining <= 0) {
+                clearInterval(el._kwTimer);
+            }
+        }
+        tick();
+        el._kwTimer = setInterval(tick, 1000);
+    }
+
+    function initMore(button) {
+        var root = document.getElementById(button.getAttribute("aria-controls") || "");
+        if (!root) {
+            return;
+        }
+        button.addEventListener("click", function () {
+            var open = !root.classList.contains("is-expanded");
+            root.classList.toggle("is-expanded", open);
+            button.setAttribute("aria-expanded", String(open));
+            button.textContent = open ? "Show fewer sections" : "See more sections";
+        });
+    }
+
+    /* ---------- hero carousel -------------------------------------------- */
+
+    var HERO_INTERVAL_MS = 6000;
+
+    /**
+     * Rotates the hero slides. Stops for reduced-motion users, when the visitor
+     * presses pause, while the pointer or keyboard focus is inside the banner,
+     * and while the tab is hidden. Left and Right arrows move between slides.
+     */
+    function initCarousel(root) {
+        var slides = $$("[data-kw-slide]", root);
+        var dots = $$("[data-kw-dot]", root);
+        var pause = $("[data-kw-pause]", root);
+        var prev = $("[data-kw-prev]", root);
+        var next = $("[data-kw-next]", root);
+        if (slides.length < 2) {
+            return;
+        }
+
+        var current = 0;
+        var timer = null;
+        var userPaused = false;
+        var hovering = false;
+        var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+
+        function show(index) {
+            current = (index + slides.length) % slides.length;
+            slides.forEach(function (slide, i) {
+                var active = i === current;
+                slide.classList.toggle("is-active", active);
+                slide.setAttribute("aria-hidden", String(!active));
+            });
+            dots.forEach(function (dot, i) {
+                dot.setAttribute("aria-current", String(i === current));
+            });
+        }
+
+        function running() {
+            return !userPaused && !hovering && !reduceMotion && !document.hidden;
+        }
+
+        function stop() {
+            clearInterval(timer);
+            timer = null;
+        }
+
+        function start() {
+            stop();
+            if (running()) {
+                timer = setInterval(function () { show(current + 1); }, HERO_INTERVAL_MS);
+            }
+        }
+
+        function setPaused(value) {
+            userPaused = value;
+            if (pause) {
+                pause.setAttribute("aria-pressed", String(value));
+                pause.setAttribute("aria-label", value ? "Play slideshow" : "Pause slideshow");
+            }
+            start();
+        }
+
+        dots.forEach(function (dot, i) {
+            dot.addEventListener("click", function () { show(i); start(); });
+        });
+        if (prev) {
+            prev.addEventListener("click", function () { show(current - 1); start(); });
+        }
+        if (next) {
+            next.addEventListener("click", function () { show(current + 1); start(); });
+        }
+        if (pause) {
+            pause.addEventListener("click", function () { setPaused(!userPaused); });
+        }
+
+        root.addEventListener("mouseenter", function () { hovering = true; start(); });
+        root.addEventListener("mouseleave", function () { hovering = false; start(); });
+        root.addEventListener("focusin", function () { hovering = true; start(); });
+        root.addEventListener("focusout", function () { hovering = false; start(); });
+
+        root.addEventListener("keydown", function (e) {
+            if (e.key === "ArrowRight") {
+                e.preventDefault();
+                show(current + 1);
+                start();
+            } else if (e.key === "ArrowLeft") {
+                e.preventDefault();
+                show(current - 1);
+                start();
+            }
+        });
+
+        document.addEventListener("visibilitychange", start);
+
+        if (reduceMotion && pause) {
+            pause.setAttribute("aria-pressed", "true");
+            pause.setAttribute("aria-label", "Play slideshow");
+            userPaused = true;
+        }
+        show(0);
+        start();
+    }
+
+    /* ---------- boot ----------------------------------------------------- */
+
+    function ready(fn) {
+        if (document.readyState === "loading") {
+            document.addEventListener("DOMContentLoaded", fn);
+        } else {
+            fn();
+        }
+    }
+
+    ready(function () {
+        $$("[data-kw-suggest]").forEach(initSuggest);
+        $$("[data-kw-fav]").forEach(initFavourites);
+        $$("[data-kw-thumb]").forEach(initGallery);
+        $$("[data-kw-qty]").forEach(initQuantity);
+        $$("[data-kw-toggle]").forEach(initToggle);
