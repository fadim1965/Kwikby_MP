@using Microsoft.Extensions.Options
@using kwikby_MP.Services
@inject IThemeCatalog ThemeCatalog
@{
    ViewData["Title"] = "Location Unmapped";

    // Gracefully resolve styling metrics using the context framework
    var resolvedTheme = Context.Items["Tenant_Shop_Theme"] as ShopTheme ?? ThemeCatalog.Default;
    var currentQueryCode = Context.Request.Query["code"].ToString();
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center py-4">
            <!-- Large styled status indicator badge referencing custom design system properties -->
            <div class="mb-3 display-1 fw-extrabold" style="color: var(--brand-primary); font-size: 5rem; letter-spacing: -2px; opacity: 0.15;">
                404
            </div>

            <h1 class="h3 fw-bold text-dark mb-2">The requested resource could not be found</h1>
            <p class="text-muted mb-4 mx-auto" style="max-width: 460px;">
                The store slug, product SKU, or marketplace link you followed may have expired, changed locations, or been unmapped by the merchant vendor.
            </p>

            <!-- Quick Search Redirection Utility Integration Box -->
            <div class="card card-body p-4 bg-white border-0 shadow-sm mb-4">
                <h6 class="fw-bold mb-3 text-dark text-start">Looking for something else?</h6>
                <form class="d-flex gap-2" role="search" asp-controller="Catalog" asp-action="Index" method="get">
                    <input class="form-control" type="search" name="q" placeholder="Search categories, items, or local shops..." autocomplete="off" required />
                    <button class="btn btn-brand px-4 py-2" type="submit">Search</button>
                </form>
            </div>

            <div class="d-flex flex-wrap justify-content-center gap-3 fs-6">
                <a href="/" class="fw-bold text-decoration-none" style="color: var(--brand-primary);">&larr; Marketplace Directory</a>
                <span class="text-muted opacity-50">|</span>
                <a asp-controller="Catalog" asp-action="Index" class="fw-semibold text-secondary text-decoration-none">All Storefronts</a>
                <span class="text-muted opacity-50">|</span>
                <a asp-controller="Orders" asp-action="Track" class="fw-semibold text-secondary text-decoration-none">Track Order Status</a>
            </div>
        </div>
    </div>
</div>
