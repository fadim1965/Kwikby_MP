@using Microsoft.Extensions.Options
@using kwikby_MP.Services.Localization
@inject IOptions<kwikby_MP.Domain.StoreSettings> StoreOptions
@inject IOptions<kwikby_MP.Domain.BrandingOptions> BrandOptions
@inject kwikby_MP.Services.IThemeCatalog ThemeCatalog
@inject ITranslator T
@{
    var store = StoreOptions.Value;
    var brand = BrandOptions.Value;
    var message = TempData["Message"] as string;
    var messageType = TempData["MessageType"] as string ?? "success";

    // The theme resolved by the tenant middleware for this request (shop storefronts), or the default.
    var resolvedTheme = Context.Items["Tenant_Shop_Theme"] as kwikby_MP.Domain.ShopTheme ?? ThemeCatalog.Default;

    var dir = T.IsRightToLeft ? "rtl" : "ltr";
    var isAdmin = User.IsInRole("Admin");
    var isSignedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="@T.Culture" dir="@dir" data-lang="@T.Culture"
      style="
        --brand-primary: @resolvedTheme.Primary;
        --brand-primary-dark: @resolvedTheme.PrimaryDark;
        --brand-primary-darker: @resolvedTheme.PrimaryDarker;
        --brand-primary-light: @resolvedTheme.PrimaryLight;
        --brand-primary-tint: @resolvedTheme.PrimaryTint;
        --brand-accent: @resolvedTheme.Accent;
        --brand-accent-dark: @resolvedTheme.AccentDark;
        --brand-ink: @resolvedTheme.Ink;
        --brand-ink-muted: @resolvedTheme.InkMuted;
        --brand-ink-subtle: @resolvedTheme.InkSubtle;
        --brand-surface: @resolvedTheme.Surface;
        --brand-surface-muted: @resolvedTheme.SurfaceMuted;
        --brand-surface-raised: @resolvedTheme.SurfaceRaised;
        --brand-border: @resolvedTheme.Border;
        --brand-border-strong: @resolvedTheme.BorderStrong;
        --brand-danger: @resolvedTheme.Danger;
        --brand-success: @resolvedTheme.Success;
        --brand-radius: @(resolvedTheme.Radius)px;
        --brand-shadow: @resolvedTheme.Shadow;
        --brand-font: @resolvedTheme.FontStack;
      ">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is null ? "kwikby" : $"{ViewData["Title"]} · kwikby")</title>
    <meta name="theme-color" content="@resolvedTheme.Primary" />
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Kwikby design system: loaded last so its header, navigation and home styles take precedence. -->
    <link rel="stylesheet" href="~/css/kwikby.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="kw-skip" href="#main">Skip to content</a>

    <!-- Top bar: language, order tracking, account -->
    <div class="kw-topbar">
        <div class="kw-container kw-topbar__inner">
            <div class="kw-topbar__links">
                <a asp-controller="Catalog" asp-action="Index">@T["controller.catalog"]</a>
            </div>
            <div class="kw-topbar__links">
                <a asp-controller="Orders" asp-action="Track">@T["controller.track"]</a>
                @if (isSignedIn)
                {
                    @if (isAdmin)
                    {
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">HQ Backoffice</a>
                    }
                    <a asp-area="Vendor" asp-controller="Dashboard" asp-action="Index">Seller Hub</a>
                    <a asp-controller="Account" asp-action="Profile">@User.Identity!.Name</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="kw-topbar__button">@T["controller.signout"]</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">@T["controller.login"]</a>
                }
            </div>
        </div>
    </div>

    <!-- Header: logo, search with suggestions, shop links, cart -->
    <header class="kw-header">
        <div class="kw-container kw-header__bar">
            <a class="kw-logo" asp-controller="Home" asp-action="Index" aria-label="kwikby home">
                <img src="~/images/kwikby_logo.png" alt="kwikby" width="132" height="44" />
            </a>

            <form class="kw-search" role="search" asp-controller="Catalog" asp-action="Index" method="get">
                <label class="kw-visually-hidden" for="kw-q">@T["controller.searchLabel"]</label>
                <input id="kw-q" class="kw-search__input" type="search" name="q"
                       value="@Context.Request.Query["q"]" placeholder="@T["controller.searchLabel"]"
                       autocomplete="off" aria-expanded="false" aria-controls="kw-suggest-list"
                       data-kw-suggest data-url="@Url.Action("Suggest", "Catalog")" />
                <ul id="kw-suggest-list" class="kw-suggest" role="listbox"></ul>
                <button class="kw-search__submit" type="submit" aria-label="Search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
                </button>
            </form>

            <div class="kw-header__actions">
                <a class="kw-header__link" asp-area="Vendor" asp-controller="Onboarding" asp-action="Register">Sell on kwikby</a>
                @await Component.InvokeAsync("CartBadge")
            </div>
        </div>

        <!-- Navigation: categories panel and mega menu -->
        <nav class="kw-nav" aria-label="Main">
            <div class="kw-container kw-nav__inner">
                <div class="kw-menu">
                    <button class="kw-menu__trigger" type="button" aria-expanded="false" aria-controls="kw-categories" data-kw-menu-trigger>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                        <span>Categories</span>
                    </button>
                    <div id="kw-categories" class="kw-categories" hidden>
                        @await Component.InvokeAsync("CategoryMenu")
                        <a class="kw-categories__all" asp-controller="Catalog" asp-action="Index">All categories</a>
                    </div>
                </div>

                <ul class="kw-nav__list" aria-label="Browse">
                    <li class="kw-menu">
                        <button class="kw-menu__trigger" type="button" aria-expanded="false" aria-controls="mega-new" data-kw-menu-trigger>
                            <span>New arrivals</span>
                            <svg class="kw-menu__chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5" /></svg>
                        </button>
                    </li>
                    <li class="kw-menu">
                        <button class="kw-menu__trigger" type="button" aria-expanded="false" aria-controls="mega-deals" data-kw-menu-trigger>
                            <span>Deals</span>
                            <svg class="kw-menu__chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5" /></svg>
                        </button>
                    </li>
                    <li><a class="kw-nav__link" asp-controller="Shops" asp-action="Index">@T["controller.shops"]</a></li>
                </ul>
            </div>

            <div id="mega-new" class="kw-mega" hidden>
                <div class="kw-container kw-mega__inner">
                    <div>
                        <h3>Shop new</h3>
                        <ul>
                            <li><a class="kw-mega__link kw-mega__link--strong" asp-controller="Catalog" asp-action="Index" asp-route-sort="Newest">Newest first</a></li>
                            <li><a class="kw-mega__link" asp-controller="Catalog" asp-action="Index" asp-route-sort="BestSelling">Best selling</a></li>
                            <li><a class="kw-mega__link" asp-controller="Catalog" asp-action="Index" asp-route-sort="TopRated">Top rated</a></li>
                        </ul>
                    </div>
                    <div>
                        <h3>Shops</h3>
                        <ul>
                            <li><a class="kw-mega__link" asp-controller="Shops" asp-action="Index">Browse all shops</a></li>
                        </ul>
                    </div>
                    <div class="kw-promo">
                        <span class="kw-promo__eyebrow">New on kwikby</span>
                        <h4>Fresh products from local vendors</h4>
                        <a class="kw-btn kw-btn--outline kw-small" asp-controller="Catalog" asp-action="Index" asp-route-sort="Newest">Shop new arrivals</a>
                    </div>
                </div>
            </div>

            <div id="mega-deals" class="kw-mega" hidden>
                <div class="kw-container kw-mega__inner">
                    <div>
                        <h3>Price</h3>
                        <ul>
                            <li><a class="kw-mega__link kw-mega__link--strong" asp-controller="Catalog" asp-action="Index" asp-route-sort="PriceLowToHigh">Lowest prices first</a></li>
                            <li><a class="kw-mega__link" asp-controller="Catalog" asp-action="Index" asp-route-maxPrice="25">Under @(store.CurrencySymbol)25</a></li>
                        </ul>
                    </div>
                    <div>
                        <h3>Availability</h3>
                        <ul>
                            <li><a class="kw-mega__link" asp-controller="Catalog" asp-action="Index" asp-route-inStock="true">In stock now</a></li>
                        </ul>
                    </div>
                    <div class="kw-promo kw-promo--green">
                        <span class="kw-promo__eyebrow">Deals</span>
                        <h4>Lowest prices from our vendors</h4>
                        <a class="kw-btn kw-btn--outline kw-small" asp-controller="Catalog" asp-action="Index" asp-route-sort="PriceLowToHigh">Shop deals</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="kw-container mt-3">
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-@messageType alert-dismissible fade show" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <main id="main" class="kw-container kw-main flex-grow-1">
        @RenderBody()
    </main>

    <footer class="kw-footer">
        <div class="kw-container">
            <div class="kw-footer__grid">
                <div class="kw-footer__brand">
                    <img src="~/images/kwikby_logo.png" alt="kwikby" width="120" height="40" />
                    <p>@T["footer.legal"]</p>
                </div>
                <nav aria-labelledby="ft-shop">
                    <h2 id="ft-shop">Shop</h2>
                    <ul>
                        <li><a asp-controller="Catalog" asp-action="Index">All products</a></li>
                        <li><a asp-controller="Shops" asp-action="Index">@T["controller.shops"]</a></li>
                        <li><a asp-controller="Orders" asp-action="Track">@T["controller.track"]</a></li>
                    </ul>
                </nav>
                <nav aria-labelledby="ft-sell">
                    <h2 id="ft-sell">Sell</h2>
                    <ul>
                        <li><a asp-area="Vendor" asp-controller="Onboarding" asp-action="Register">Open a shop</a></li>
                    </ul>
                </nav>
                <nav aria-labelledby="ft-help">
                    <h2 id="ft-help">Help</h2>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Privacy">@T["footer.privacy"]</a></li>
                        <li>Support: <a href="mailto:@store.SupportEmail">@store.SupportEmail</a></li>
                    </ul>
                </nav>
            </div>
            <div class="kw-footer__bottom">
                <span>&copy; @DateTime.UtcNow.Year @store.Name. All rights reserved.</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/kwikby.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
