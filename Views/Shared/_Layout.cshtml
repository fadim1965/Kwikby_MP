<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Kwikby</title>
    <link rel="stylesheet" href="~/css/kwikby.css" asp-append-version="true" />
</head>
<body>
    <a class="kw-skip" href="#main">Skip to content</a>

    <header class="kw-header">
  <div class="kw-container kw-header__bar">
    <a class="kw-logo" href="#" aria-label="Kwikby home"><img src="~/images/kwikby_logo.png" alt="Kwikby" width="44" height="44"></a>
    <form class="kw-search" role="search" action="#" onsubmit="return false;">
      <label class="kw-visually-hidden" for="kw-q">Search for anything</label>
      <input id="kw-q" class="kw-search__input" type="search" placeholder="Search for anything" autocomplete="off"
             aria-expanded="false" aria-controls="kw-suggest-list" data-kw-suggest>
      <ul id="kw-suggest-list" class="kw-suggest" role="listbox"></ul>
      <button class="kw-search__submit" type="submit" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      </button>
    </form>
    <div class="kw-header__actions">
      <a class="kw-header__link" href="#">Sign in</a>
      <a class="kw-header__link" href="#">Sell on Kwikby</a>
      <button class="kw-icon-btn" type="button" aria-label="Favourites">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-4.35-9.5-8.5C.9 9.6 2.4 5.5 6.2 5.1c2.1-.2 3.6 1 4.3 2.3.7-1.3 2.2-2.5 4.3-2.3 3.8.4 5.3 4.5 3.7 7.4C19 16.65 12 21 12 21z"/></svg>
      </button>
      <a class="kw-icon-btn" href="#" aria-label="Cart, 2 items">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M6 6L5 3H2"/></svg>
        <span class="kw-count">2</span>
      </a>
    </div>
  </div>
  <nav class="kw-nav" aria-label="Main">
    <div class="kw-container kw-nav__inner">
      <div class="kw-menu">
        <button class="kw-menu__trigger" type="button" aria-expanded="false" aria-controls="kw-categories" data-kw-menu-trigger>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <span>Categories</span>
        </button>
        <div id="kw-categories" class="kw-categories" hidden>
          <ul class="kw-categories__list">
          <li><a class="kw-categories__link" href="#">Jewellery<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4.5 2.5L8 6l-3.5 3.5"/></svg></a></li>
          <li><a class="kw-categories__link" href="#">Home &amp; Living<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4.5 2.5L8 6l-3.5 3.5"/></svg></a></li>
          <li><a class="kw-categories__link" href="#">Art &amp; Prints<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4.5 2.5L8 6l-3.5 3.5"/></svg></a></li>
          <li><a class="kw-categories__link" href="#">Gifts<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4.5 2.5L8 6l-3.5 3.5"/></svg></a></li>
          <li><a class="kw-categories__link" href="#">Vintage<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4.5 2.5L8 6l-3.5 3.5"/></svg></a></li>
          <li><a class="kw-categories__link" href="#">Bags &amp; Leather<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4.5 2.5L8 6l-3.5 3.5"/></svg></a></li>
          <li><a class="kw-categories__link" href="#">Clothing &amp; Accessories<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4.5 2.5L8 6l-3.5 3.5"/></svg></a></li>
          <li><a class="kw-categories__link" href="#">Crafts &amp; Supplies<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4.5 2.5L8 6l-3.5 3.5"/></svg></a></li>
          <li><a class="kw-categories__link" href="#">Wedding<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4.5 2.5L8 6l-3.5 3.5"/></svg></a></li>
          </ul>
          <a class="kw-categories__all" href="#">All categories</a>
        </div>
      </div>

      <ul class="kw-nav__list" aria-label="Browse">
        <li class="kw-menu"><button class="kw-menu__trigger" type="button" aria-expanded="false" aria-controls="mega-new" data-kw-menu-trigger><span>New arrivals</span><svg class="kw-menu__chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5"/></svg></button></li>
        <li class="kw-menu"><button class="kw-menu__trigger" type="button" aria-expanded="false" aria-controls="mega-deals" data-kw-menu-trigger><span>Deals</span><svg class="kw-menu__chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5"/></svg></button></li>
        <li class="kw-menu"><button class="kw-menu__trigger" type="button" aria-expanded="false" aria-controls="mega-gifts" data-kw-menu-trigger><span>Gifts</span><svg class="kw-menu__chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5"/></svg></button></li>
        <li class="kw-menu"><button class="kw-menu__trigger" type="button" aria-expanded="false" aria-controls="mega-shops" data-kw-menu-trigger><span>Shops</span><svg class="kw-menu__chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5"/></svg></button></li>
        <li class="kw-menu"><button class="kw-menu__trigger" type="button" aria-expanded="false" aria-controls="mega-brands" data-kw-menu-trigger><span>Brands</span><svg class="kw-menu__chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5"/></svg></button></li>
        <li><a class="kw-nav__link kw-menu__trigger" href="#">Sell</a></li>
      </ul>
    </div>

  <div id="mega-new" class="kw-mega" hidden>
    <div class="kw-container kw-mega__inner">
      <div><h3>Shop new</h3><ul><li><a class="kw-mega__link kw-mega__link--strong" href="#">All new arrivals</a></li><li><a class="kw-mega__link" href="#">Last 24 hours</a></li><li><a class="kw-mega__link" href="#">Last 7 days</a></li><li><a class="kw-mega__link" href="#">Back in stock</a></li></ul></div>
      <div><h3>By category</h3><ul><li><a class="kw-mega__link kw-mega__link--strong" href="#">Jewellery</a></li><li><a class="kw-mega__link" href="#">Home &amp; Living</a></li><li><a class="kw-mega__link" href="#">Art &amp; Prints</a></li></ul></div>
      <div><h3>Local makers</h3><ul><li><a class="kw-mega__link kw-mega__link--strong" href="#">New from Beirut</a></li><li><a class="kw-mega__link" href="#">New from Tripoli</a></li><li><a class="kw-mega__link" href="#">New from Jbeil</a></li></ul></div>
      <div class="kw-promo"><span class="kw-promo__eyebrow">Spring edit</span><h4>Fresh pieces from this week's makers</h4><a class="kw-btn kw-btn--outline kw-small" href="#">Shop the edit</a></div>
    </div>
  </div>
  <div id="mega-deals" class="kw-mega" hidden>
    <div class="kw-container kw-mega__inner">
      <div><h3>By discount</h3><ul><li><a class="kw-mega__link kw-mega__link--strong" href="#">Up to 25% off</a></li><li><a class="kw-mega__link" href="#">Up to 50% off</a></li><li><a class="kw-mega__link" href="#">Flash sales, ending soon</a></li></ul></div>
      <div><h3>Free shipping</h3><ul><li><a class="kw-mega__link kw-mega__link--strong" href="#">Free shipping over $40</a></li><li><a class="kw-mega__link" href="#">Free delivery in Lebanon</a></li></ul></div>
      <div><h3>Clearance</h3><ul><li><a class="kw-mega__link kw-mega__link--strong" href="#">Last chance sales</a></li><li><a class="kw-mega__link" href="#">Shops clearing stock</a></li></ul></div>
      <div class="kw-promo kw-promo--green"><span class="kw-promo__eyebrow">Ends tonight</span><h4>Deals that finish before midnight</h4><a class="kw-btn kw-btn--outline kw-small" href="#">See all deals</a></div>
    </div>
  </div>
  <div id="mega-gifts" class="kw-mega" hidden>
    <div class="kw-container kw-mega__inner">
      <div><h3>Gift guides</h3><ul><li><a class="kw-mega__link kw-mega__link--strong" href="#">For her</a></li><li><a class="kw-mega__link" href="#">For him</a></li><li><a class="kw-mega__link" href="#">For kids</a></li><li><a class="kw-mega__link" href="#">Under $25</a></li></ul></div>
      <div><h3>By occasion</h3><ul><li><a class="kw-mega__link kw-mega__link--strong" href="#">Weddings</a></li><li><a class="kw-mega__link" href="#">Birthdays</a></li><li><a class="kw-mega__link" href="#">Housewarming</a></li><li><a class="kw-mega__link" href="#">Corporate gifts</a></li></ul></div>
      <div><h3>Gift cards</h3><ul><li><a class="kw-mega__link kw-mega__link--strong" href="#">Buy a gift card</a></li><li><a class="kw-mega__link" href="#">Redeem a gift card</a></li></ul></div>
      <div class="kw-promo"><span class="kw-promo__eyebrow">Gift guide</span><h4>Gifts for every occasion, from makers you can trust</h4><a class="kw-btn kw-btn--outline kw-small" href="#">Browse gift guides</a></div>
    </div>
  </div>
  <div id="mega-shops" class="kw-mega" hidden>
    <div class="kw-container kw-mega__inner">
      <div><h3>Browse shops</h3><ul><li><a class="kw-mega__link kw-mega__link--strong" href="#">Star sellers</a></li><li><a class="kw-mega__link" href="#">Top rated shops</a></li><li><a class="kw-mega__link" href="#">New shops</a></li><li><a class="kw-mega__link" href="#">Shops that ship fast</a></li></ul></div>
      <div><h3>By city</h3><ul><li><a class="kw-mega__link kw-mega__link--strong" href="#">Beirut</a></li><li><a class="kw-mega__link" href="#">Tripoli</a></li><li><a class="kw-mega__link" href="#">Jbeil</a></li><li><a class="kw-mega__link" href="#">Saida</a></li></ul></div>
      <div><h3>Community</h3><ul><li><a class="kw-mega__link kw-mega__link--strong" href="#">Meet our makers</a></li><li><a class="kw-mega__link" href="#">Shop of the week</a></li></ul></div>
      <div class="kw-promo"><span class="kw-promo__eyebrow">Makers</span><h4>Meet the shops behind the products</h4><a class="kw-btn kw-btn--outline kw-small" href="#">Explore shops</a></div>
    </div>
  </div>
  <div id="mega-brands" class="kw-mega" hidden>
    <div class="kw-container kw-mega__inner">
      <div><h3>Featured brands</h3><ul><li><a class="kw-mega__link kw-mega__link--strong" href="#">Atelier Bekaa</a></li><li><a class="kw-mega__link" href="#">Jbeil Woodworks</a></li><li><a class="kw-mega__link" href="#">Clay &amp; Kiln Studio</a></li></ul></div>
      <div><h3>Directory</h3><ul><li><a class="kw-mega__link kw-mega__link--strong" href="#">A to Z brands</a></li><li><a class="kw-mega__link" href="#">New brands</a></li><li><a class="kw-mega__link" href="#">Heritage brands</a></li></ul></div>
      <div><h3>Collections</h3><ul><li><a class="kw-mega__link kw-mega__link--strong" href="#">Lebanese craft</a></li><li><a class="kw-mega__link" href="#">Sustainable picks</a></li></ul></div>
      <div class="kw-promo"><span class="kw-promo__eyebrow">Brands</span><h4>Curated brands, chosen by our editors</h4><a class="kw-btn kw-btn--outline kw-small" href="#">Browse brands</a></div>
    </div>
  </div>

  </nav>
</header>

    <main id="main" class="kw-container">
        @RenderBody()
    </main>

    <footer class="kw-footer">
  <div class="kw-container">
    <div class="kw-footer__grid">
      <div class="kw-footer__brand">
        <img src="~/images/kwikby_logo.png" alt="Kwikby" width="40" height="40">
        <p>A marketplace for independent makers and small shops in Lebanon.</p>
        <a class="kw-btn kw-btn--outline kw-small" href="#">Start selling</a>
      </div>
      <nav aria-labelledby="f1"><h2 id="f1">Shop</h2><ul><li><a href="#">Categories</a></li><li><a href="#">Gift cards</a></li><li><a href="#">New arrivals</a></li></ul></nav>
      <nav aria-labelledby="f2"><h2 id="f2">Sell</h2><ul><li><a href="#">Open a shop</a></li><li><a href="#">Seller handbook</a></li><li><a href="#">Fees</a></li></ul></nav>
      <nav aria-labelledby="f3"><h2 id="f3">Help</h2><ul><li><a href="#">Help centre</a></li><li><a href="#">Returns</a></li><li><a href="#">Contact</a></li></ul></nav>
    </div>
    <div class="kw-footer__bottom">
      <span>&copy; 2026 Kwikby. All rights reserved.</span>
      <span><a href="#">Privacy</a> &middot; <a href="#">Terms</a> &middot; <a href="#">Cookies</a></span>
    </div>
  </div>
</footer>

    <script src="~/js/kwikby.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
