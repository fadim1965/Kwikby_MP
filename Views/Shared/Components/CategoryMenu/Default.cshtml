@model IReadOnlyList<kwikby_MP.Domain.Category>
@*
    Department list for the Categories panel in the header navigation.
    Rendered as a plain list; the panel's container supplies the styling.
*@
@if (Model.Count == 0)
{
    <p class="kw-categories__empty">No departments yet</p>
}
else
{
    <ul class="kw-categories__list">
        @foreach (var category in Model)
        {
            <li>
                <a class="kw-categories__link" asp-controller="Catalog" asp-action="Index" asp-route-category="@category.Slug">
                    <span>@category.Name</span>
                    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4.5 2.5L8 6l-3.5 3.5" /></svg>
                </a>
            </li>
        }
    </ul>
}
