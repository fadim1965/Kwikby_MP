@model WebDS_Test.Controllers.ShopStorefrontViewModel
@{
    ViewData["Title"] = Model.Shop.Name;
    var shop = Model.Shop;
    var qs = Context.Request.Query;
    var results = Model.Results;
    var totalPages = Math.Max(1, (int)Math.Ceiling(results.TotalCount / (double)results.PageSize));
    var initial = string.IsNullOrWhiteSpace(shop.Name) ? "?" : shop.Name.Substring(0, 1).ToUpperInvariant();
    var currentSort = qs["sort"].ToString();
    var minPriceValue = qs["minPrice"].ToString();
    var maxPriceValue = qs["maxPrice"].ToString();
    var brandValue = qs["brand"].ToString();
    var searchValue = qs["q"].ToString();
    var inStockChecked = string.Equals(qs["inStock"].ToString(), "true", StringComparison.OrdinalIgnoreCase);
}

<!-- Storefront header: the same design for every shop -->
<section class="kw-shop" aria-labelledby="shop-title">
    <div class="kw-shop__banner" aria-hidden="true"></div>
    <div class="kw-shop__body">
        <div class="kw-shop__avatar" aria-hidden="true">@initial</div>
        <div class="kw-shop__info">
            <h1 id="shop-title" class="kw-shop__name">@shop.Name</h1>
            <div class="kw-shop__meta">
                @if (!string.IsNullOrWhiteSpace(shop.City))
                {
                    <span>@shop.City</span>
                }
                @if (Model.Rating.HasRatings)
                {
                    <span>@Model.Rating.Average.ToString("0.0") rating (@Model.Rating.Count reviews)</span>
                }
                else
                {
                    <span>No reviews yet</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(shop.Tagline))
            {
                <p class="kw-muted" style="margin:6px 0 0">@shop.Tagline</p>
            }
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(shop.Description))
    {
        <p class="kw-muted" style="margin:0;padding:0 24px 22px">@shop.Description</p>
    }
</section>

<div class="kw-browse">
    <!-- Sort & filter: categories, product types (brands) and price come from this shop's products -->
    <aside class="kw-filters" aria-label="Sort and filter">
        <h2 class="kw-filters__title">Sort &amp; filter</h2>

        <form id="kw-shop-filters" method="get" asp-controller="Shops" asp-action="Details" asp-route-slug="@shop.Slug">
            <fieldset class="kw-filter-group">
                <legend class="kw-filter-group__label">Categories</legend>
                @if (Model.Categories.Count > 0)
                {
                    <label class="kw-check">
                        <input type="radio" name="category" value="" checked="@string.IsNullOrEmpty(qs["category"].ToString())" />
                        <span>All in @shop.Name</span>
                    </label>
                    <partial name="_KwCategoryTree" model="Model.Categories" />
                }
                else
                {
                    <p class="kw-muted kw-small">No categories yet</p>
                }
            </fieldset>

            <fieldset class="kw-filter-group">
                <legend class="kw-filter-group__label">Product types</legend>
                @if (Model.Brands.Count > 0)
                {
                    <label class="kw-check">
                        <input type="radio" name="brand" value="" checked="@string.IsNullOrEmpty(brandValue)" />
                        <span>All types</span>
                    </label>
                    @foreach (var brand in Model.Brands)
                    {
                        <label class="kw-check">
                            <input type="radio" name="brand" value="@brand" checked="@string.Equals(brandValue, brand, StringComparison.OrdinalIgnoreCase)" />
                            <span>@brand</span>
                        </label>
                    }
                }
                else
                {
                    <p class="kw-muted kw-small">No product types yet</p>
                }
            </fieldset>

            <fieldset class="kw-filter-group">
                <legend class="kw-filter-group__label">Price</legend>
                <div class="kw-range">
                    <input class="kw-input" type="number" name="minPrice" min="0" step="0.01"
                           value="@minPriceValue" placeholder="@(Model.PriceBounds.Min.ToString("0"))" aria-label="From" />
                    <span class="kw-muted">to</span>
                    <input class="kw-input" type="number" name="maxPrice" min="0" step="0.01"
                           value="@maxPriceValue" placeholder="@(Model.PriceBounds.Max.ToString("0"))" aria-label="To" />
                </div>
                <button class="kw-btn kw-btn--outline kw-small" type="submit" style="margin-top:10px">Apply price</button>
            </fieldset>

            <fieldset class="kw-filter-group">
                <legend class="kw-filter-group__label">Availability</legend>
                <label class="kw-check">
                    <input type="checkbox" name="inStock" value="true" checked="@inStockChecked" />
                    <span>In stock only</span>
                </label>
            </fieldset>

            <input type="hidden" name="q" value="@searchValue" />
        </form>
    </aside>

    <div>
        <div class="kw-browse__toolbar">
            <span class="kw-results-count">@results.TotalCount items</span>
            <div style="display:flex;align-items:center;gap:10px">
                <label class="kw-visually-hidden" for="kw-shop-sort" form="kw-shop-filters">Sort by</label>
                <select id="kw-shop-sort" class="kw-select" name="sort" form="kw-shop-filters" data-kw-autosubmit>
                    <option value="Newest" selected="@(currentSort == "" || currentSort == "Newest")">Newest</option>
                    <option value="PriceLowToHigh" selected="@(currentSort == "PriceLowToHigh")">Price: low to high</option>
                    <option value="PriceHighToLow" selected="@(currentSort == "PriceHighToLow")">Price: high to low</option>
                    <option value="BestSelling" selected="@(currentSort == "BestSelling")">Best selling</option>
                    <option value="TopRated" selected="@(currentSort == "TopRated")">Top rated</option>
                    <option value="NameAscending" selected="@(currentSort == "NameAscending")">Name A to Z</option>
                </select>
            </div>
        </div>

        @if (results.Items.Count == 0)
        {
            <div class="kw-empty">
                <h2>No products match these filters</h2>
                <p class="kw-muted">Try clearing a filter, or browse all products from this shop.</p>
                <a class="kw-btn kw-btn--brand" asp-controller="Shops" asp-action="Details" asp-route-slug="@shop.Slug">Clear filters</a>
            </div>
        }
        else
        {
            <ul class="kw-grid">
                @foreach (var card in results.Items)
                {
                    <li><partial name="_KwProductCard" model="card" /></li>
                }
            </ul>
        }

        @if (totalPages > 1)
        {
            <nav class="kw-pager" aria-label="Pages" style="display:flex;gap:10px;justify-content:center;align-items:center;margin-top:24px">
                @if (results.Page > 1)
                {
                    <a class="kw-btn kw-btn--outline" asp-controller="Shops" asp-action="Details" asp-route-slug="@shop.Slug"
                       asp-route-page="@(results.Page - 1)" asp-route-category="@qs["category"].ToString()"
                       asp-route-brand="@brandValue" asp-route-sort="@currentSort" asp-route-q="@searchValue"
                       asp-route-minPrice="@minPriceValue" asp-route-maxPrice="@maxPriceValue" asp-route-inStock="@(inStockChecked ? "true" : "")">Previous</a>
                }
                <span class="kw-muted">Page @results.Page of @totalPages</span>
                @if (results.Page < totalPages)
                {
                    <a class="kw-btn kw-btn--outline" asp-controller="Shops" asp-action="Details" asp-route-slug="@shop.Slug"
                       asp-route-page="@(results.Page + 1)" asp-route-category="@qs["category"].ToString()"
                       asp-route-brand="@brandValue" asp-route-sort="@currentSort" asp-route-q="@searchValue"
                       asp-route-minPrice="@minPriceValue" asp-route-maxPrice="@maxPriceValue" asp-route-inStock="@(inStockChecked ? "true" : "")">Next</a>
                }
            </nav>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Radio and checkbox filters submit the sidebar form as soon as they change.
        document.querySelectorAll('#kw-shop-filters input[type="radio"], #kw-shop-filters input[type="checkbox"]').forEach(function (input) {
            input.addEventListener('change', function () { input.form.submit(); });
        });
    </script>
}
