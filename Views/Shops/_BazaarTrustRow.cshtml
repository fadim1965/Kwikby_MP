@model kwikby_MP.Controllers.ShopStorefrontViewModel
<section class="bazaar-trust" aria-label="Why shop here">
    <div class="bazaar-trust-item">
        <span class="bazaar-trust-icon" aria-hidden="true">&#128666;</span>
        <div><strong>Delivery across Lebanon</strong><br /><span class="small text-muted">Dispatched by this shop through LibanPost.</span></div>
    </div>
    <div class="bazaar-trust-item">
        <span class="bazaar-trust-icon" aria-hidden="true">&#128179;</span>
        <div><strong>Cash on delivery or card</strong><br /><span class="small text-muted">Choose at checkout.</span></div>
    </div>
    <div class="bazaar-trust-item">
        <span class="bazaar-trust-icon" aria-hidden="true">&#8634;</span>
        <div><strong>Return requests</strong><br /><span class="small text-muted">Open a return from your order history.</span></div>
    </div>
    <div class="bazaar-trust-item">
        <span class="bazaar-trust-icon" aria-hidden="true">&#9733;</span>
        <div><strong>Verified reviews</strong><br /><span class="small text-muted">Only buyers of a product can review it.</span></div>
    </div>
</section>
